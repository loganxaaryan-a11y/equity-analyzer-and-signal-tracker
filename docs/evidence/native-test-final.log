58 |   test("candidate abstentions and baseline eligibility are evaluated independently", () => { const bars = cryptoBars(304, "2025-11-01"); const index = bars.findIndex((bar) => bar.date === "2026-07-01"), feature = bars[index]; const prior = bars.slice(index - 199, index); if (!feature || prior.length !== 199) throw new Error("abstention fixture"); const equalSma = prior.reduce((sum, bar) => sum + bar.close, 0) / prior.length; feature.open = equalSma; feature.close = equalSma; feature.high = equalSma + 1; feature.low = equalSma - 1; const result = runValidation(dataset([series("crypto", "BTC", bars)]), oneProduct("crypto-5-trend-v1")); const row = result.observations.find((item) => item.decisionDate === "2026-07-01"); expect(row).toMatchObject({ decisionState: "abstain", baselineEligibility: "eligible" }); expect(row?.baselineReason).toBe("all_scheduled_sma_inputs_available"); expect(row?.direction).toBeNull(); });
